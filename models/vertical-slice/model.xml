<mujoco model="robobuddy_vertical_slice">
  <compiler angle="radian" coordinate="local"/>
  <option timestep="0.002" integrator="RK4" gravity="0 0 -9.81"/>
  <default>
    <geom friction="0.8 0.02 0.002" condim="3"/>
    <joint damping="0.1"/>
  </default>
  <worldbody>
    <light pos="0 0 3" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="2 2 0.1" rgba="0.7 0.7 0.7 1"/>
    <body name="table" pos="0 0 0.35">
      <geom name="table_top" type="box" size="0.5 0.35 0.03" mass="8" rgba="0.45 0.45 0.48 1"/>
    </body>
    <body name="pendulum_base" pos="-0.35 0 0.55">
      <geom type="box" size="0.08 0.08 0.08" mass="1" rgba="0.2 0.45 0.7 1"/>
      <body name="link" pos="0 0 0.08">
        <joint name="hinge" type="hinge" axis="0 1 0" range="-1.57 1.57" limited="true"/>
        <geom name="link_geom" type="capsule" fromto="0 0 0 0 0 0.35" size="0.035" mass="0.5" rgba="0.25 0.65 0.8 1"/>
      </body>
    </body>
    <body name="free_box" pos="0.25 0 1.0">
      <freejoint/>
      <geom name="free_box_geom" type="box" size="0.055 0.055 0.055" mass="0.25" rgba="0.85 0.45 0.2 1"/>
    </body>
  </worldbody>
  <actuator>
    <position name="hinge_position" joint="hinge" kp="20" ctrllimited="true" ctrlrange="-1.2 1.2" forcelimited="true" forcerange="-5 5"/>
  </actuator>
  <sensor>
    <jointpos name="hinge_pos" joint="hinge"/>
    <jointvel name="hinge_vel" joint="hinge"/>
    <framepos name="box_pos" objtype="body" objname="free_box"/>
  </sensor>
</mujoco>
